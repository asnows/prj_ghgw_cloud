# ===== 股海怪物云服务 配置模板 =====
# 复制为 .env 并填写真实值；所有密钥不得入库

# 服务
APP_ENV=dev                  # dev | prod
HOST=0.0.0.0
PORT=8000

# 数据库（SQLite 起步；生产可换 PostgreSQL，见 README）
DATABASE_URL=sqlite:///./ghgw_cloud.db

# 签名密钥（服务端发码/校验用；与 skill 端 license_pub.key 保持一致）
# 生成：python tools/gen_keys.py
LICENSE_SECRET=CHANGE_ME_GENERATE_WITH_GEN_KEYS

# 微信支付 V3（未配置时自动进入 MOCK 模式，便于开发测试）
WXPAY_ENABLED=false
WXPAY_MCHID=
WXPAY_APPID=
WXPAY_APIV3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=https://your-domain.com/pay/webhook

# 套餐（天）
PLAN_MONTH_DAYS=30
PLAN_YEAR_DAYS=365
PLAN_MONTH_PRICE=2900         # 单位：分（微信支付）→ ¥29
PLAN_YEAR_PRICE=19900         # → ¥199

# 设备绑定上限
MAX_DEVICES_PER_LICENSE=3

# 管理后台
ADMIN_TOKEN=CHANGE_ME_ADMIN

# skill 分析引擎路径（复用股海怪物 skill 的 scripts）
SKILL_DIR=/sandbox/workspace/skills/gu-hai-guai-wu
